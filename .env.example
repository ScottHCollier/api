# Local development credentials only. Compose and the API read these values.
POSTGRES_DB=final_third
POSTGRES_USER=final_third
POSTGRES_PASSWORD=final_third_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=8000
SEED_ON_STARTUP=false
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://montpellier-fc.localhost:3000","http://oakwood-united.localhost:3000"]
# Enable if your filesystem does not deliver change notifications to containers.
WATCHFILES_FORCE_POLLING=false
FA_IMPORT_ENABLED=true
FA_IMPORT_INTERVAL_SECONDS=86400
FA_REQUEST_TIMEOUT_SECONDS=20
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=final-third-media
OBJECT_STORAGE_PRIVATE_BUCKET=final-third-private
OBJECT_STORAGE_ACCESS_KEY=final-third-dev
OBJECT_STORAGE_SECRET_KEY=final-third-dev-secret
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/final-third-media
APP_BASE_URL=http://localhost:3000
CLUB_BASE_DOMAIN=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_AUDIENCE_ID=
