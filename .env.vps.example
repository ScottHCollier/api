# Copy this file to .env.staging or .env.production on the VPS.
# Do not commit the copied file.

POSTGRES_DB=final_third
POSTGRES_USER=final_third
POSTGRES_PASSWORD=replace-with-a-long-random-password
SEED_ON_STARTUP=false
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

APP_BASE_URL=https://staging.scottcollier.dev
CLUB_BASE_DOMAIN=staging.scottcollier.dev
CORS_ORIGINS=["https://staging.scottcollier.dev"]

FA_IMPORT_ENABLED=true
FA_IMPORT_INTERVAL_SECONDS=86400
FA_IMPORT_QUEUE_INTERVAL_SECONDS=15
FA_REQUEST_TIMEOUT_SECONDS=20

# Cloudflare R2 S3 API settings.
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=final-third-staging-media
OBJECT_STORAGE_PRIVATE_BUCKET=final-third-staging-private
OBJECT_STORAGE_ACCESS_KEY=replace-with-r2-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-r2-secret
OBJECT_STORAGE_PUBLIC_BASE_URL=https://staging-assets.scottcollier.dev

RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Final Third <noreply@staging.scottcollier.dev>
RESEND_AUDIENCE_ID=

WEB_CONCURRENCY=2
